{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jairus-blog-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "route": {
    "pattern": "auth.jairus.dev",
    "custom_domain": true
  },
  "vars": {
    "CMS_ORIGIN": "https://blog.jairus.dev",
    "GITHUB_REPO_PRIVATE": "false"
  }
}
